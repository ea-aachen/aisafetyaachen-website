---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { href } from '../lib/links';
import together from '../assets/images/AISA-Together-SM-Final-v01.jpeg';
import care from '../assets/images/AISA-Care-SM-Final-v01-Large.jpeg';
import flyer from '../assets/images/flyer.png';
import worldmap from '../assets/images/black-textile-41949.jpg';

const whatsapp = 'https://chat.whatsapp.com/Et3lbbGQ3AbCW744qmuv0L';

const pillars = [
  { title: 'Educate', body: 'We learn together through programs, hackathons, events and discussions.' },
  { title: 'Connect', body: 'We plug into a worldwide community of people dedicated to this problem.' },
  { title: 'Support', body: 'We help each other make long-term plans to contribute through our careers, engagement or advocacy.' },
];
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line/60">
    <Image src={worldmap} alt="" widths={[1280, 1920, 2399]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-ink/40"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-28 sm:py-36">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">AI Safety Aachen e.V.</p>
      <h1 class="mt-5 max-w-3xl text-4xl font-bold leading-[1.15] tracking-tight sm:text-5xl">
        We are committed to reduce catastrophic risks from advanced AI systems, by promoting responsible AI development
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-fg-muted">
        If this sounds interesting to you, join us at one of our weekly events.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={whatsapp} class="rounded-full bg-accent px-6 py-3 font-semibold text-ink transition hover:bg-accent-soft">Join us</a>
        <a href={href('/cal')} class="rounded-full border border-line bg-ink/40 px-6 py-3 font-semibold text-fg backdrop-blur transition hover:border-accent hover:text-accent">Weekly events</a>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
    <div class="grid gap-5 sm:grid-cols-3">
      {pillars.map((p) => (
        <div class="rounded-2xl border border-line/60 bg-ink-soft p-6">
          <h3 class="text-lg font-semibold text-accent">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- What we do -->
  <section class="border-y border-line/60 bg-ink-soft">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 sm:py-24 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">What we do</h2>
        <p class="mt-5 leading-relaxed text-fg-muted">
          AI Safety Aachen is a student initiative dedicated to reducing the risks posed by advanced AI systems. We aim
          to empower students and academics in Aachen to address this pressing problem — learning about the risks
          together, working out how to reduce them, and developing the skills to contribute.
        </p>
      </div>
      <div class="relative">
        <div class="absolute -inset-3 rounded-3xl bg-accent/10 blur-2xl"></div>
        <Image src={together} alt="The AI Safety Aachen community" widths={[480, 800]} class="relative w-full rounded-2xl border border-line/60 object-cover shadow-[var(--shadow-glow)]" />
      </div>
    </div>
  </section>

  <!-- AI Safety explainer -->
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 sm:py-24 lg:grid-cols-2">
    <div class="order-2 lg:order-1">
      <Image src={care} alt="Caring about safe AI" widths={[480, 800]} class="w-full rounded-2xl border border-line/60 object-cover" />
    </div>
    <div class="order-1 lg:order-2">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Why AI safety</h2>
      <p class="mt-5 leading-relaxed text-fg-muted">
        AI is advancing rapidly and brings huge potential for good. But in a recent survey, 48% of AI experts put the
        risk of human extinction from AI at more than 10%
        (<a href="https://aiimpacts.org/what-do-ml-researchers-think-about-ai-in-2022/" class="text-accent hover:underline">Grace et al, 2022</a>).
        Companies are racing to deploy frontier models while the underlying technology remains largely a black box, with
        no rigorous theory of how to make these systems safe. We believe there are still fundamental questions to answer
        to ensure advanced AI is beneficial rather than harmful.
      </p>
      <a href="https://www.cold-takes.com/why-ai-alignment-could-be-hard-with-modern-deep-learning/" class="mt-6 inline-block font-semibold text-accent hover:underline">Introduction to AI safety →</a>
    </div>
  </section>

  <!-- Flyer -->
  <section class="border-t border-line/60 bg-ink-soft">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Our flyer</h2>
      <p class="mx-auto mt-4 max-w-xl text-center leading-relaxed text-fg-muted">
        Who we are, what we offer and how to get involved — at a glance.
      </p>
      <a
        href="https://flyer.felkru.com/"
        target="_blank"
        rel="noopener"
        class="mt-10 block overflow-hidden rounded-2xl border border-line/60 shadow-[var(--shadow-glow)] transition hover:border-accent"
      >
        <Image
          src={flyer}
          alt="AI Safety Aachen flyer — about us, our offerings, and how to get involved"
          widths={[768, 1152, 1920]}
          sizes="(max-width: 1152px) 100vw, 1152px"
          quality={90}
          class="w-full"
        />
      </a>
      <p class="mt-4 text-center text-sm text-fg-muted">
        <a href="https://flyer.felkru.com/" target="_blank" rel="noopener" class="text-accent hover:underline">Open the full flyer →</a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line/60 bg-gradient-to-b from-ink-soft to-ink">
    <div class="mx-auto max-w-3xl px-5 py-20 text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Get involved</h2>
      <p class="mt-4 text-fg-muted">Come along to one of our weekly events — everyone is welcome, whatever your background.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={whatsapp} class="rounded-full bg-accent px-6 py-3 font-semibold text-ink transition hover:bg-accent-soft">Join us</a>
        <a href={href('/cal')} class="rounded-full border border-line px-6 py-3 font-semibold text-fg transition hover:border-accent hover:text-accent">Weekly events</a>
      </div>
    </div>
  </section>
</Base>
